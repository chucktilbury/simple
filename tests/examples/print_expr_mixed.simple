# Expressions – mixed formulas

start {
    int x
    int y
    int z
    int n
    int sum
    int i

    x = 2
    y = 5
    z = 8

    print "=== mixed expressions ==="
    print "x={}, y={}, z={}"(x, y, z)
    print "x*x + y*y = {}"(x * x + y * y)
    print "(z - y) * x = {}"((z - y) * x)
    print "z / x + y = {}"(z / x + y)
    print "x + y * z = {}"(x + y * z)
    print "(x + y) * z = {}"((x + y) * z)

    # sum 1..n
    n = 5
    sum = 0
    i = 1
    while (i lte n) {
        sum = sum + i
        print "  after adding {}: sum = {}"(i, sum)
        i = i + 1
    }
    print "sum 1..{} = {}"(n, sum)
}
